{
	"name": "Overseer - AI Development Platform",
	"dockerComposeFile": "docker-compose.yml",
	"service": "app",
	"workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
	"features": {
		"ghcr.io/devcontainers/features/node:1": {
			"version": "22.18.0"
		},
		"ghcr.io/devcontainers/features/git:1": {}
	},
	"containerEnv": {
		"NODE_ENV": "development",
		"OVERSEER_ENV": "development",
		"DATABASE_URL": "postgresql://overseer:overseer_dev_password@postgres:5432/overseer",
		"REDIS_URL": "redis://redis:6379/0"
	},
	"remoteUser": "vscode",
	"mounts": [
		{
			"source": "${localEnv:HOME}/.vscode-server",
			"target": "/home/vscode/.vscode-server",
			"type": "bind"
		},
		{
			"source": "${localEnv:HOME}/.cline",
			"target": "/home/vscode/.cline",
			"type": "bind"
		},
		{
			"source": "overseer-vscode-extensions",
			"target": "/home/vscode/.vscode-server/extensions",
			"type": "volume"
		}
	],
	"customizations": {
		"vscode": {
			"settings": {
				"python.defaultInterpreterPath": "/usr/local/bin/python",
				"editor.formatOnSave": true,
				"cline.taskContextPersistence": true,
				"cline.autoSaveTaskContext": true
			},
			"extensions": [
				"ms-python.python",
				"ms-python.black-formatter",
				"ms-vscode.vscode-json",
				"ms-vscode.vscode-docker",
				"ms-python.pylint",
				"ms-python.flake8",
				"saoudrizwan.claude-dev",
				"GitHub.copilot",
				"GitHub.copilot-chat",
				"ms-vscode.remote-containers",
				"ms-vscode.remote-ssh",
				"ms-vscode.remote-wsl",
				"ms-vscode.npm-scripts"
			]
		}
	},
	"forwardPorts": [
		3000,
		8000,
		5432,
		6379
	],
	"portsAttributes": {
		"3000": {
			"label": "Frontend Dev Server"
		},
		"8000": {
			"label": "API Server"
		},
		"5432": {
			"label": "PostgreSQL Database"
		},
		"6379": {
			"label": "Redis Cache"
		}
	},
	"shutdownAction": "stopCompose"
}
